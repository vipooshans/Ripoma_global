# Copy to .dev.vars for local `npm run dev` (wrangler). Never commit .dev.vars.

NODE_ENV=production
FRONTEND_URL=https://ripoma-global.pages.dev
CORS_PAGES_HOST=ripoma-global.pages.dev

# --- Mode B: proxy to an already-running Express host (Render / Fly / Railway) ---
# When set, the Worker skips Containers and reverse-proxies to this origin.
# API_ORIGIN=https://YOUR-SERVICE.onrender.com

# --- Mode A: Cloudflare Containers (required secrets if API_ORIGIN is unset) ---
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/ripoma_global
JWT_SECRET=change_me_staff_access
JWT_REFRESH_SECRET=change_me_staff_refresh
CUSTOMER_JWT_SECRET=change_me_customer_access
CUSTOMER_JWT_REFRESH_SECRET=change_me_customer_refresh

# Optional
# GOOGLE_CLIENT_ID=
# CUSTOMER_REQUIRE_EMAIL_VERIFICATION=true
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=notifications@ripomaglobal.com
# STORAGE_PROVIDER=r2   # r2 | s3 | local — documents & report exports
# PRODUCT_IMAGE_STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PRODUCT_BUCKET=ripoma-product-images
# R2_PUBLIC_URL=https://images.example.com
# R2_DOCUMENTS_BUCKET=ripoma-documents
