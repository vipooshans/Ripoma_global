# Cloudflare Pages → Settings → Environment variables (Production + Preview)
# Vite inlines these at BUILD time — rebuild after changing.

VITE_API_URL=https://ripomaglobal1.ripomaglobal.workers.dev/api
VITE_SOCKET_URL=https://ripomaglobal1.ripomaglobal.workers.dev
VITE_GOOGLE_CLIENT_ID=140622339758-03aobin1o3qfct6fdn3bpfe5hr2gujsv.apps.googleusercontent.com

# Must include https:// — without it the browser treats the value as a path on
# ripoma-global.pages.dev and you get 405s like:
# https://ripoma-global.pages.dev/ripomaglobal1.ripomaglobal.workers.dev/api/...
