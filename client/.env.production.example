# Cloudflare Pages → Settings → Environment variables (Production)
# Vite inlines these at build time.

# Worker gateway (Containers or API_ORIGIN proxy):
VITE_API_URL=https://ripomaglobal1.ripomaglobal.workers.dev/api
VITE_SOCKET_URL=https://ripomaglobal1.ripomaglobal.workers.dev

# Or point straight at Render / Fly (skip the Worker):
# VITE_API_URL=https://YOUR-SERVICE.onrender.com/api
# VITE_SOCKET_URL=https://YOUR-SERVICE.onrender.com

VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
