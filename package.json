{
  "name": "ripoma-cloudflare",
  "private": true,
  "description": "Cloudflare Worker gateway + Container for Rippoma Express API",
  "scripts": {
    "deploy": "wrangler deploy",
    "deploy:proxy": "node scripts/deploy-proxy.mjs",
    "api:tunnel": "node scripts/refresh-api-origin.mjs",
    "dev": "wrangler dev",
    "dev:proxy": "wrangler dev -c wrangler.proxy.jsonc",
    "containers:list": "wrangler containers list"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.0.30"
  },
  "devDependencies": {
    "wrangler": "^4.112.0"
  }
}
