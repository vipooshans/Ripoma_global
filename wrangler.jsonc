/**
 * Rippoma API gateway.
 *
 * Deploy: npm run deploy  (Docker Desktop must be running for Containers)
 *
 * Mode A — Containers: set secrets (MONGODB_URI, JWT_*, CUSTOMER_JWT_*, …)
 * Mode B — External Express: also set secret API_ORIGIN=https://….onrender.com
 *          (Worker proxies; Containers still deploy but are unused when API_ORIGIN is set)
 *
 * Pages frontend vars: see client/.env.production.example
 */
{
  "name": "ripomaglobal1",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "NODE_ENV": "production",
    "FRONTEND_URL": "https://ripoma-global.pages.dev",
    "CORS_PAGES_HOST": "ripoma-global.pages.dev"
    // Optional plaintext: "API_ORIGIN": "https://YOUR-SERVICE.onrender.com"
  },
  "containers": [
    {
      "class_name": "RipomaApi",
      "image": "./server/Dockerfile",
      "max_instances": 3,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RIPOMA_API",
        "class_name": "RipomaApi"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RipomaApi"]
    }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
