/**
 * Proxy-only Worker (no Cloudflare Containers).
 * Use when Express runs on Render / Fly / Railway.
 *
 *   npx wrangler secret put API_ORIGIN -c wrangler.proxy.jsonc
 *   # value: https://YOUR-SERVICE.onrender.com
 *   npm run deploy:proxy
 */
{
  "name": "ripomaglobal1",
  "main": "worker/src/proxy.js",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "api.ripomaglobal.org",
      "zone_name": "ripomaglobal.org",
      "custom_domain": true
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "FRONTEND_URL": "https://ripomaglobal.org",
    "CORS_ORIGINS": "https://ripomaglobal.org,https://www.ripomaglobal.org,https://ripoma-global.pages.dev",
    "CORS_PAGES_HOST": "ripoma-global.pages.dev",
    "GOOGLE_CLIENT_ID": "140622339758-03aobin1o3qfct6fdn3bpfe5hr2gujsv.apps.googleusercontent.com"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RIPOMA_API",
        "class_name": "RipomaApi"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RipomaApi"
      ]
    }
  ],
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": true,
      "persist": true,
      "invocation_logs": true
    }
  },
  "d1_databases": [
    {
      "binding": "ripoma_db",
      "database_name": "ripoma-db",
      "database_id": "5ea18c20-f058-4c9d-81e2-e2952097b8fe",
      "migrations_dir": "d1/migrations",
      "remote": true
    }
  ]
}
